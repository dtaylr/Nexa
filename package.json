{
  "name": "1platform",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "seed": "npm run seed --workspace=apps/api",
    "build:api": "npm run build --workspace=apps/api",
    "test:contracts:finance": "vitest run tests/finance/contracts --reporter=json --reporter=junit --outputFile.json=results/vitest/contracts-finance.json --outputFile.junit=results/vitest/contracts-finance.junit.xml",
    "test:contracts:health": "vitest run tests/health/contracts --reporter=json --reporter=junit --outputFile.json=results/vitest/contracts-health.json --outputFile.junit=results/vitest/contracts-health.junit.xml",
    "test:contracts:commerce": "vitest run tests/commerce/contracts --reporter=json --reporter=junit --outputFile.json=results/vitest/contracts-commerce.json --outputFile.junit=results/vitest/contracts-commerce.junit.xml",
    "test:smoke:finance": "vitest run tests/finance/p0-smoke --reporter=json --reporter=junit --outputFile.json=results/vitest/smoke-finance.json --outputFile.junit=results/vitest/smoke-finance.junit.xml",
    "test:smoke:health": "vitest run tests/health/p0-smoke --reporter=json --reporter=junit --outputFile.json=results/vitest/smoke-health.json --outputFile.junit=results/vitest/smoke-health.junit.xml",
    "test:smoke:commerce": "vitest run tests/commerce/p0-smoke --reporter=json --reporter=junit --outputFile.json=results/vitest/smoke-commerce.json --outputFile.junit=results/vitest/smoke-commerce.junit.xml",
    "test:regression:finance": "vitest run tests/finance/api tests/finance/p1-regression --reporter=json --reporter=junit --outputFile.json=results/vitest/regression-finance.json --outputFile.junit=results/vitest/regression-finance.junit.xml",
    "test:regression:health": "vitest run tests/health/api tests/health/p1-regression --reporter=json --reporter=junit --outputFile.json=results/vitest/regression-health.json --outputFile.junit=results/vitest/regression-health.junit.xml",
    "test:regression:commerce": "vitest run tests/commerce/api tests/commerce/p1-regression --reporter=json --reporter=junit --outputFile.json=results/vitest/regression-commerce.json --outputFile.junit=results/vitest/regression-commerce.junit.xml",
    "test:negative:finance": "vitest run tests/finance/negative --reporter=json --reporter=junit --outputFile.json=results/vitest/negative-finance.json --outputFile.junit=results/vitest/negative-finance.junit.xml",
    "test:negative:health": "vitest run tests/health/negative --reporter=json --reporter=junit --outputFile.json=results/vitest/negative-health.json --outputFile.junit=results/vitest/negative-health.junit.xml",
    "test:negative:commerce": "vitest run tests/commerce/negative --reporter=json --reporter=junit --outputFile.json=results/vitest/negative-commerce.json --outputFile.junit=results/vitest/negative-commerce.junit.xml",
    "test:api:finance": "vitest run tests/finance/api tests/finance/p0-smoke tests/finance/p1-regression tests/finance/negative --reporter=json --reporter=junit --outputFile.json=results/vitest/api-finance.json --outputFile.junit=results/vitest/api-finance.junit.xml",
    "test:api:health": "vitest run tests/health/api tests/health/p0-smoke tests/health/p1-regression tests/health/negative --reporter=json --reporter=junit --outputFile.json=results/vitest/api-health.json --outputFile.junit=results/vitest/api-health.junit.xml",
    "test:api:commerce": "vitest run tests/commerce/api tests/commerce/p0-smoke tests/commerce/p1-regression tests/commerce/negative --reporter=json --reporter=junit --outputFile.json=results/vitest/api-commerce.json --outputFile.junit=results/vitest/api-commerce.junit.xml",
    "test:p0:smoke": "vitest run tests/smoke tests/finance/p0-smoke tests/health/p0-smoke tests/commerce/p0-smoke --reporter=json --reporter=junit --outputFile.json=results/vitest/p0-smoke.json --outputFile.junit=results/vitest/p0-smoke.junit.xml",
    "test:health:ml": "vitest run ai/ml/__tests__/ --reporter=json --reporter=junit --outputFile.json=results/vitest/health-ml.json --outputFile.junit=results/vitest/health-ml.junit.xml",
    "test:health:concurrency": "vitest run tests/health/concurrency --reporter=json --reporter=junit --outputFile.json=results/vitest/health-concurrency.json --outputFile.junit=results/vitest/health-concurrency.junit.xml",
    "test:health:chaos": "vitest run tests/health/chaos --reporter=json --reporter=junit --outputFile.json=results/vitest/health-chaos.json --outputFile.junit=results/vitest/health-chaos.junit.xml",
    "test:security": "vitest run tests/security --reporter=json --reporter=junit --outputFile.json=results/vitest/security.json --outputFile.junit=results/vitest/security.junit.xml",
    "test:e2e:finance": "playwright test tests/finance/ui",
    "test:e2e:health": "playwright test tests/health/ui",
    "test:e2e:commerce": "playwright test tests/commerce/ui",
    "test:a11y": "playwright test tests/health/accessibility tests/commerce/accessibility",
    "test:visual": "playwright test tests/visual",
    "test:visual:update": "playwright test tests/visual --update-snapshots",
    "test:e2e:smoke": "playwright test tests/smoke",
    "test:e2e:regression": "playwright test tests/finance/ui tests/health/ui tests/commerce/ui tests/smoke",
    "test:mobile": "playwright test tests/commerce/ui/checkout-mobile.spec.ts tests/finance/ui/finance-mobile.spec.ts tests/health/ui/health-mobile.spec.ts --project=mobile-chrome --project=mobile-safari --project=mobile-small --project=tablet",
    "test:mobile:chrome": "playwright test tests/commerce/ui/checkout-mobile.spec.ts tests/finance/ui/finance-mobile.spec.ts tests/health/ui/health-mobile.spec.ts --project=mobile-chrome",
    "test:mobile:safari": "playwright test tests/commerce/ui/checkout-mobile.spec.ts tests/finance/ui/finance-mobile.spec.ts tests/health/ui/health-mobile.spec.ts --project=mobile-safari",
    "test:cross-browser": "playwright test tests/finance/ui tests/health/ui tests/commerce/ui tests/smoke --project=chromium --project=firefox --project=webkit",
    "test:browsers:desktop": "playwright test --project=chromium --project=firefox --project=webkit",
    "pw": "tsx scripts/playwright-select.ts",
    "pw:smoke": "tsx scripts/playwright-select.ts --tag @smoke --project chromium",
    "pw:regression": "tsx scripts/playwright-select.ts --tag @regression --project chromium",
    "pw:mobile": "tsx scripts/playwright-select.ts --tag @mobile --device all-mobile",
    "pw:a11y": "tsx scripts/playwright-select.ts --tag @a11y --project chromium",
    "pw:finance": "tsx scripts/playwright-select.ts --domain finance --project chromium",
    "pw:health": "tsx scripts/playwright-select.ts --domain health --project chromium",
    "pw:commerce": "tsx scripts/playwright-select.ts --domain commerce --project chromium",
    "test:bdd": "cucumber-js",
    "test:load:finance": "k6 run tests/finance/performance/transfer-load.k6.js -e BASE_URL=http://localhost:3001",
    "test:load:commerce": "k6 run tests/commerce/performance/product-browse.k6.js -e BASE_URL=http://localhost:3001",
    "test:mutation": "stryker run",
    "triage:analyze": "tsx ai/triage-engine/analyze.ts",
    "cost:report": "tsx ai/triage-engine/cost-report.ts",
    "test:ml": "vitest run ai/ml/__tests__/",
    "ml:train-anomaly": "tsx ai/ml/training/train-anomaly.ts",
    "ml:flakiness": "tsx ai/ml/training/evaluate-flakiness.ts --results-dir results --output artifacts/flakiness-report.json",
    "open:report": "open results/report.html",
    "open:stakeholder": "open results/stakeholder-report.html",
    "open:vitest": "open results/vitest/index.html",
    "open:lighthouse": "open results/lighthouse/",
    "open:coverage": "open results/coverage/index.html",
    "matrix:build": "tsx scripts/test-matrix.ts",
    "matrix:report": "tsx scripts/generate-stakeholder-report.ts",
    "matrix:all": "npm run matrix:build && npm run matrix:report",
    "report": "tsx scripts/generate-report.ts",
    "repo:structure": "tsx scripts/check-repo-structure.ts",
    "test:report": "npm run test:api:finance && npm run test:api:health && npm run test:api:commerce && npm run test:security && npm run test:health:ml && npm run report",
    "full:report": "npm run test:report && npm run matrix:all",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:seed": "docker compose run --rm seed",
    "docker:logs": "docker compose logs -f",
    "docker:reset": "docker compose down -v && docker compose up --build -d",
    "test:lighthouse": "npm run build --workspace=apps/web && node scripts/lhci-run.js",
    "test:lighthouse:view": "open results/lighthouse/",
    "test:bruno": "bru run bruno/1platform-api --env local",
    "test:bruno:finance": "bru run bruno/1platform-api/finance --env local",
    "test:bruno:health": "bru run bruno/1platform-api/health --env local",
    "test:bruno:commerce": "bru run bruno/1platform-api/commerce --env local",
    "lint": "eslint apps/api/src apps/web/src tests ai --ext .ts,.tsx --max-warnings 0",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^8.57.0",
    "@cucumber/cucumber": "^13.2.0",
    "@cucumber/pretty-formatter": "^4.0.0",
    "@lhci/cli": "^0.15.1",
    "@pact-foundation/pact": "^12.1.0",
    "@playwright/test": "^1.62.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.8",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^24.13.3",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^9.0.7",
    "@usebruno/cli": "^1.40.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.11.1",
    "concurrently": "^8.2.2",
    "jsonwebtoken": "^9.0.2",
    "supertest": "^6.3.4",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "uuid": "^9.0.0",
    "vitest": "^4.1.10",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "decimal.js": "^10.4.3"
  }
}
