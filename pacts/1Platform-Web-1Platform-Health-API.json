{
  "consumer": {
    "name": "1Platform-Web"
  },
  "interactions": [
    {
      "description": "a request for the current patient profile",
      "providerStates": [
        {
          "name": "authenticated patient exists"
        }
      ],
      "request": {
        "headers": {
          "Authorization": "Bearer eyJhbGciOiJIUzI1NiJ9"
        },
        "matchingRules": {
          "header": {
            "Authorization": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "method": "GET",
        "path": "/api/HealthyU/patients/me"
      },
      "response": {
        "body": {
          "bloodType": "O+",
          "dob": "1990-01-01",
          "id": "pat-001",
          "name": "Alice Patient"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.bloodType": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.dob": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.name": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          },
          "status": {}
        },
        "status": 200
      }
    },
    {
      "description": "a request for patient appointments",
      "providerStates": [
        {
          "name": "authenticated patient has appointments"
        }
      ],
      "request": {
        "headers": {
          "Authorization": "Bearer eyJhbGciOiJIUzI1NiJ9"
        },
        "matchingRules": {
          "header": {
            "Authorization": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "method": "GET",
        "path": "/api/HealthyU/appointments"
      },
      "response": {
        "body": [
          {
            "date": "2026-04-01T10:00:00.000Z",
            "doctor": "Dr. Smith",
            "id": "appt-001",
            "status": "scheduled"
          }
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$[*].date": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$[*].doctor": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$[*].id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$[*].status": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          },
          "status": {}
        },
        "status": 200
      }
    }
  ],
  "metadata": {
    "pact-js": {
      "version": "12.5.2"
    },
    "pactRust": {
      "ffi": "0.4.20",
      "models": "1.2.0"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "1Platform-Health-API"
  }
}