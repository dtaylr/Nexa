meta {
  name: Login — Patient
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "patient.one@1platform.dev",
    "password": "password123"
  }
}

tests {
  test("Status 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Stores patient token", function() {
    const body = res.getBody();
    expect(body.token).to.be.a("string");
    bru.setEnvVar("patientToken", body.token);
  });

  test("User role is patient", function() {
    expect(res.getBody().user.role).to.equal("patient");
  });
}
