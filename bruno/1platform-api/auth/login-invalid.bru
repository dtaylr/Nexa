meta {
  name: Login — Invalid Credentials (negative)
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "nobody@1platform.dev",
    "password": "wrongpassword"
  }
}

tests {
  test("Status 401", function() {
    expect(res.getStatus()).to.equal(401);
  });

  test("No token in response", function() {
    expect(res.getBody().token).to.be.undefined;
  });
}
