meta {
  name: Get Account Transactions
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/finance/accounts/{{accountId}}/transactions
  body: none
  auth: bearer
}

auth:bearer {
  token: {{aliceToken}}
}

tests {
  test("Status 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Returns transactions array", function() {
    expect(res.getBody().transactions).to.be.an("array");
  });
}
