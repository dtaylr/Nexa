meta {
  name: Process Payment
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/commerce/orders/{{orderId}}/payment
  body: json
  auth: bearer
}

auth:bearer {
  token: {{shopperToken}}
}

body:json {
  {
    "method": "card",
    "amount": 49.99,
    "currency": "USD",
    "cardToken": "tok_test_visa_4242"
  }
}

tests {
  test("Status 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Payment captured", function() {
    const body = res.getBody();
    expect(body.status).to.equal("CAPTURED");
    expect(body.paymentId).to.be.a("string");
    expect(body.receiptUrl).to.be.a("string");
  });
}
