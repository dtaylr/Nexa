meta {
  name: Remove from Wishlist
  type: http
  seq: 13
}

delete {
  url: {{baseUrl}}/api/commerce/wishlist/{{productId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{shopperToken}}
}

tests {
  test("Status 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Item removed confirmation", function() {
    expect(res.getBody().removed).to.equal(true);
  });
}
