meta {
  name: Get Wishlist
  type: http
  seq: 11
}

get {
  url: {{baseUrl}}/api/commerce/wishlist
  body: none
  auth: bearer
}

auth:bearer {
  token: {{shopperToken}}
}

tests {
  test("Status 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Returns wishlist items array", function() {
    expect(res.getBody().items).to.be.an("array");
  });
}
