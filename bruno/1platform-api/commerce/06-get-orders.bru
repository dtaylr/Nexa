meta {
  name: Get Orders
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/commerce/orders
  body: none
  auth: bearer
}

auth:bearer {
  token: {{shopperToken}}
}

tests {
  test("Status 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Returns orders array", function() {
    expect(res.getBody().orders).to.be.an("array");
  });
}
