meta {
  name: Get My Patient Profile
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/health/patients/me
  body: none
  auth: bearer
}

auth:bearer {
  token: {{patientToken}}
}

tests {
  test("Status 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Stores patientId", function() {
    const body = res.getBody();
    expect(body.id).to.be.a("number");
    bru.setEnvVar("patientId", body.id);
  });

  test("Has required patient fields", function() {
    const body = res.getBody();
    expect(body.firstName).to.be.a("string");
    expect(body.lastName).to.be.a("string");
    expect(body.nhsNumber).to.be.a("string");
  });
}
