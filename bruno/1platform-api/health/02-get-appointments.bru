meta {
  name: Get Patient Appointments
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/health/patients/{{patientId}}/appointments
  body: none
  auth: bearer
}

auth:bearer {
  token: {{patientToken}}
}

tests {
  test("Status 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Returns appointments array", function() {
    expect(res.getBody().appointments).to.be.an("array");
  });
}
