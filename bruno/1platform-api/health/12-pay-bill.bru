meta {
  name: Pay Bill
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/api/health/patients/{{patientId}}/billing/{{billId}}/pay
  body: json
  auth: bearer
}

auth:bearer {
  token: {{patientToken}}
}

body:json {
  {
    "amount": 75.00,
    "method": "card"
  }
}

vars:pre-request {
  billId: replace-with-a-real-bill-id
}

tests {
  test("Status 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Returns success confirmation", function() {
    expect(res.getBody().success).to.equal(true);
    expect(res.getBody().paidAt).to.be.a("string");
  });
}
