meta {
  name: Get Lab Results
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/health/patients/{{patientId}}/lab-results
  body: none
  auth: bearer
}

auth:bearer {
  token: {{patientToken}}
}

tests {
  test("Status 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Returns labResults array", function() {
    expect(res.getBody().labResults).to.be.an("array");
  });

  test("Critical results are flagged", function() {
    const results = res.getBody().labResults;
    const critical = results.filter(r => r.status === "critical");
    critical.forEach(r => {
      console.log("Critical result:", r.testName, r.value, r.unit);
    });
  });
}
